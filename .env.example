# Switch Server Settings
SWITCH_SERVER_URL=http://localhost:8000
SWITCH_API_KEY=your_agent_api_key_here
SWITCH_AGENT_ID=your_agent_id_here
SWITCH_REGISTRATION_TOKEN=your_bootstrap_registration_token_here
SWITCH_DEFAULT_ROOM_ID=room_default

# Mattermost Settings
MATTERMOST_URL=http://localhost:8065
MATTERMOST_TEAM=engineering
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=admin_password
MATTERMOST_BOT_TOKEN=your_bot_token_if_direct

# Target Repository Settings (Self-Contained)
TARGET_REPO_PATH=./sample_repo
ALLOWED_REPO_PATHS=./sample_repo,./

# Engineering Team Settings
HUMAN_APPROVAL_REQUIRED=true
AUTO_RUN_TESTS=true
APP_HOST=0.0.0.0
APP_PORT=8082
LOG_LEVEL=INFO
